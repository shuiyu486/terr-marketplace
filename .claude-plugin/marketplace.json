{
  "name": "terr-marketplace",
  "owner": {
    "name": "terrapin"
  },
  "description": "Terr 的 Claude Code 插件集合",
  "version": "1.0.0",
  "plugins": [
    {
      "name": "config-sync",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/shuiyu486/terr-marketplace.git",
        "path": "plugins/config-sync"
      },
      "description": "双向同步+快速兼容检查终端配置文件。管理7个文件含CLAUDE.local.md。Hash级快速检查模式。渐进式披露架构(8个reference文件)。内置代理保护+自定义排除规则。",
      "version": "1.1.3",
      "author": { "name": "ccNovaTerm" },
      "repository": "https://github.com/shuiyu486/ccNovaTerm",
      "license": "MIT",
      "keywords": ["terminal", "configuration", "sync", "wezterm", "nushell"]
    },
    {
      "name": "skills2ccPlugin",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/shuiyu486/terr-marketplace.git",
        "path": "plugins/skills2ccPlugin"
      },
      "description": "将 skill 转换为 terr-marketplace 可安装插件并发布。自动生成 plugin.json、组织目录、注册 marketplace.json",
      "version": "1.0.1",
      "author": { "name": "terrapin" },
      "repository": "https://github.com/shuiyu486/terr-marketplace",
      "license": "MIT",
      "keywords": ["marketplace", "publish", "skill-creator", "git-subdir", "plugin", "convert"]
    },
    {
      "name": "dm-api",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/shuiyu486/terr-marketplace.git",
        "path": "plugins/dm-api"
      },
      "description": "大漠插件(DaMao Plugin) API 文档查询。支持 465 个函数的参数说明、返回值和使用示例，涵盖键鼠模拟、找图找色、文字识别、背景绑定、内存读写、窗口操作等功能。",
      "version": "1.0.0",
      "author": { "name": "terrapin" },
      "license": "MIT",
      "keywords": ["大漠插件", "dm", "按键精灵", "automation", "找图", "找色", "OCR", "后台绑定", "内存读写"]
    },
    {
      "name": "skill-creator",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/shuiyu486/terr-marketplace.git",
        "path": "plugins/skill-creator"
      },
      "description": "创建、修改、修复和优化 Claude Code skills。支持 skill 全生命周期：从零创建、迭代改进、运行 evals、基准测试、盲比评估、描述触发优化、打包发布。",
      "version": "1.0.0",
      "author": { "name": "Anthropic" },
      "repository": "https://github.com/anthropics/claude-plugins-official",
      "license": "MIT",
      "keywords": ["skill", "creator", "eval", "benchmark", "improve", "fix", "repair", "optimize", "package"]
    },
    {
      "name": "hookify",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/shuiyu486/terr-marketplace.git",
        "path": "plugins/hookify"
      },
      "description": "Easily create hooks to prevent unwanted behaviors by analyzing conversation patterns. Forked with Windows encoding fix.",
      "version": "1.0.1",
      "author": { "name": "terrapin" },
      "license": "MIT",
      "keywords": ["hooks", "safety", "rules", "stop", "pretooluse", "posttooluse"]
    }
  ]
}
