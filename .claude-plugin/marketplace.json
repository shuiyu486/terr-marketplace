        "path": "plugins/config-sync"
      },
      "description": "双向同步终端配置文件（WezTerm, Nushell, Starship 等）",
      "version": "1.0.0",
      "author": { "name": "ccNovaTerm" },
      "repository": "https://github.com/shuiyu486/ccNovaTerm",
      "license": "MIT",
      "keywords": ["terminal", "configuration", "sync", "wezterm", "nushell"]
    },
    {
      "name": "skills2ccPlugin",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/shuiyu486/terr-marketplace.git",
        "path": "plugins/skills2ccPlugin"
      },
      "description": "将 skill 转换为 terr-marketplace 可安装插件并发布。自动生成 plugin.json、组织目录、注册 marketplace.json",
      "version": "1.0.0",
      "author": { "name": "terrapin" },
      "repository": "https://github.com/shuiyu486/terr-marketplace",
      "license": "MIT",
      "keywords": ["marketplace", "publish", "skill-creator", "git-subdir", "plugin", "convert"]
    },
    {
      "name": "dm-api",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/shuiyu486/terr-marketplace.git",
        "path": "plugins/dm-api"
      },
      "description": "大漠插件(DaMao Plugin) API 文档查询。支持 465 个函数的参数说明、返回值和使用示例，涵盖键鼠模拟、找图找色、文字识别、背景绑定、内存读写、窗口操作等功能。",
      "version": "1.0.0",
      "author": { "name": "terrapin" },
      "license": "MIT",
      "keywords": ["大漠插件", "dm", "按键精灵", "automation", "找图", "找色", "OCR", "后台绑定", "内存读写"]
    }
  ]
