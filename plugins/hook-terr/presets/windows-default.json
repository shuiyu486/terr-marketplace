{
  "version": 1,
  "description": "Channel preset for explicit Stop notify rules: short sound plus tray notification. Does not trigger notifications by itself.",
  "settings": {
    "notifications": {
      "sound": { "enabled": true, "timeoutMs": 800 },
      "windows_toast": { "enabled": true, "silent": true, "timeoutMs": 1500 },
      "popup": { "enabled": false },
      "custom_command": { "enabled": false }
    },
    "events": {
      "Stop": { "notifications": ["sound", "windows_toast"] }
    }
  }
}
