{
  "version": 1,
  "description": "Channel preset for explicit Stop notify rules: sound plus structured popup. Does not trigger notifications by itself.",
  "settings": {
    "notifications": {
      "sound": { "enabled": true, "timeoutMs": 800 },
      "windows_toast": { "enabled": false },
      "popup": {
        "enabled": true,
        "title": "Claude Code 提醒",
        "icon": "warning"
      }
    },
    "events": {
      "Stop": { "notifications": ["sound", "popup"] }
    }
  }
}
