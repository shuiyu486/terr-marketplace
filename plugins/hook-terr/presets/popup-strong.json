{
  "version": 1,
  "description": "Strong Windows reminder preset: sound plus structured popup.",
  "settings": {
    "notifications": {
      "sound": { "enabled": true, "timeoutMs": 800 },
      "windows_toast": { "enabled": false },
      "popup": {
        "enabled": true,
        "title": "Claude Code 提醒",
        "icon": "warning",
        "timeoutMs": 1500
      }
    },
    "events": {
      "Stop": { "notifications": ["sound", "popup"] }
    }
  }
}
