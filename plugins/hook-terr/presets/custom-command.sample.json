{
  "version": 1,
  "description": "Sample custom command preset. Review before enabling because it executes a local command. Dynamic values are available through HOOK_TERR_* environment variables only.",
  "settings": {
    "notifications": {
      "custom_command": {
        "enabled": false,
        "detached": true,
        "timeoutMs": 1000,
        "command": "Add-Type -AssemblyName System.Windows.Forms; [System.Windows.Forms.MessageBox]::Show($env:HOOK_TERR_MESSAGE, $env:HOOK_TERR_TITLE) | Out-Null"
      }
    },
    "events": {
      "Stop": { "notifications": ["custom_command"] }
    }
  }
}
